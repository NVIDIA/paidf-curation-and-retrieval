# =============================================================================
# Environment Variables for Data Curation Pipelines
# =============================================================================
#
# Copy this file and fill in your credentials:
#   cp configs/s3_config.env.template configs/s3_config.env
#   vim configs/s3_config.env
#   set -a && source configs/s3_config.env && set +a
#
# When running via Docker, these are passed automatically by the Makefile.
# When running Docker directly, pass with -e flags:
#   docker run -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY ...
# =============================================================================

# -----------------------------------------------------------------------------
# S3 Storage Credentials
# -----------------------------------------------------------------------------
# Required when input_video_path or output_clip_path use s3:// URIs.
# Also required for S3 upload of curated output.

export AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_HERE
export AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY_HERE

# S3 endpoint for S3-compatible storage (MinIO, Ceph, etc.)
# Leave empty or comment out for standard AWS S3.
export S3_ENDPOINT_URL=https://YOUR_S3_ENDPOINT

# Bucket and prefix for S3 upload operations
export S3_BUCKET=your-bucket-name
export S3_TARGET_PATH=curated

# Optional: AWS region (only needed for standard AWS S3)
# export AWS_DEFAULT_REGION=us-west-2

# -----------------------------------------------------------------------------
# HuggingFace Authentication
# -----------------------------------------------------------------------------
# Required for downloading model weights (Qwen, InternVideo2, etc.).
# Alternative: place token in ~/.config/cosmos_curator/hf_token.txt
#   or set huggingface.api_key in ~/.config/cosmos_curator/config.yaml

# export HF_TOKEN=hf_YOUR_TOKEN_HERE

# -----------------------------------------------------------------------------
# API Keys for Remote Captioning / Embedding Backends
# -----------------------------------------------------------------------------
# These are read from ~/.config/cosmos_curator/config.yaml, NOT env vars.
# Create the file at ~/.config/cosmos_curator/config.yaml with this structure:
#
#   openai:
#     caption:
#       api_key: "sk-YOUR_KEY"
#       base_url: "https://your-endpoint/v1"      # optional
#     enhance:
#       api_key: "sk-YOUR_KEY"
#       base_url: "https://your-endpoint/v1"      # optional
#     embedding:
#       api_key: "sk-YOUR_KEY"
#       base_url: "https://your-endpoint/v1"      # optional
#   gemini:
#     api_key: "YOUR_GEMINI_API_KEY"
#   huggingface:
#     api_key: "hf_YOUR_TOKEN"
#
# Required only when using specific captioning_algorithm values:
#   - "gemini"    -> needs gemini.api_key
#   - "openai"    -> needs openai.caption.api_key
#   - "vllm_async" with remote model -> may need openai.caption.api_key
#   - embedding_algorithm: "openai" -> needs openai.embedding.api_key
#   - enhance_captions_lm_variant: "openai" -> needs openai.enhance.api_key
#
# Local models (qwen, qwen3_vl_30b_fp8, nemotron, cosmos_r1, etc.) do NOT
# need API keys -- they run on local GPUs via vLLM.

# -----------------------------------------------------------------------------
# Ray / NCCL Tuning (optional)
# -----------------------------------------------------------------------------
# Uncomment to diagnose NCCL issues during multi-GPU runs:
# export NCCL_DEBUG=WARN

# Override Ray temp directory (default: /tmp/ray):
# export RAY_TEMP_DIR=/path/to/large/disk/ray_tmp
