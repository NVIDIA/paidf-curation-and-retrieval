{
  "cosmos_curator": {
    "pipeline": "split",
    "image": "cosmos-curator:2.3.0",
    "dataset_description": "Urban traffic video analytics. Shipped samples are VSS developer-profile traffic clips (1080p30). The classifier taxonomy also applies to fixed-camera intersection footage. Fixed-stride splitting, domain-specific VLM captioning, Qwen Video Classifier, SAM3 track-grounded spatial event captioning, motion scoring, caption enhancement, Cosmos-Embed1 embeddings.",
    "prompt_file": "prompt.md",
    "event_caption_prompt_file": "/data/event_caption_prompt.txt",
    "overrides": {
      "input_video_path": "/data/videos",
      "output_clip_path": "/data/output/split",
      "model_weights_path": "/config/models",
      "splitting_algorithm": "fixed-stride",
      "fixed_stride_split_duration": 10,
      "fixed_stride_min_clip_length_s": 2.0,
      "captioning_algorithm": "qwen3_vl_30b_fp8",
      "captioning_window_size": 60,
      "captioning_sampling_fps": 2.0,
      "captioning_max_output_tokens": 4096,
      "vllm_sampling_temperature": 0.1,
      "vllm_sampling_top_p": 0.001,
      "vllm_sampling_repetition_penalty": 1.05,
      "enhance_captions": true,
      "enhance_captions_prompt_variant": "default",
      "motion_filter": "score-only",
      "video_classifier": true,
      "video_classifier_use_custom_categories": true,
      "video_classifier_allow": [
        "nominal_traffic_flow",
        "vehicle_to_vehicle_collision",
        "motorcycle_or_scooter_crash",
        "vehicle_to_pedestrian_collision",
        "jaywalking",
        "person_on_ground_in_roadway",
        "vehicle_fire_or_heavy_smoke",
        "collision_aftermath",
        "emergency_vehicle_response",
        "unsafe_turn_or_right_of_way_conflict",
        "signal_violation_or_wrong_way",
        "stalled_vehicle_or_roadway_obstruction"
      ],
      "sam3": true,
      "sam3_prompts": [
        "a car",
        "a pedestrian",
        "a truck",
        "a bus",
        "a motorcycle",
        "a scooter",
        "a bicycle",
        "a traffic light",
        "a police car",
        "an ambulance",
        "a fire truck",
        "a taxi",
        "a crosswalk",
        "a stop sign"
      ],
      "sam3_target_fps": 3.0,
      "sam3_max_clip_duration_s": 45.0,
      "sam3_det_nms_thresh": 0.1,
      "sam3_region": "contour",
      "sam3_output_format": "native",
      "sam3_write_annotated_video": false,
      "sam3_annotated_video_trails": false,
      "sam3_annotated_video_label_style": "id",
      "sam3_annotated_video_mask_opacity": 0,
      "event_captioning": true,
      "event_caption_backend": "qwen",
      "event_caption_qwen_variant": "qwen3_vl_30b_fp8",
      "event_caption_prompt_file": "/data/event_caption_prompt.txt",
      "embedding_algorithm": "cosmos-embed1-224p",
      "generate_captions": true,
      "generate_embeddings": true,
      "upload_clips": true,
      "write_all_caption_json": true,
      "perf_profile": true
    }
  },
  "video_stats": {
    "camera_type": "synthetic traffic / intersection (simulations)",
    "resolution": "1920x1080",
    "fps": 30,
    "codec": "h264",
    "clip_durations_s": [89, 130]
  }
}
