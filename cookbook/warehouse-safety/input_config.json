{
  "cosmos_curator": {
    "pipeline": "split",
    "image": "cosmos-curator:2.3.0",
    "dataset_description": "Warehouse and distribution center safety monitoring. Fixed overhead cameras covering aisles, loading docks, staging areas, and forklift travel zones. Fixed-stride splitting, domain-specific VLM captioning, Qwen Video Classifier with 14 warehouse safety event categories, SAM3 track-grounded spatial event captioning (box-style overlay), motion scoring, caption enhancement, InternVideo2 embeddings.",
    "prompt_file": "prompt.md",
    "event_caption_prompt_file": "/data/event_caption_prompt.txt",
    "overrides": {
      "input_video_path": "/data/videos",
      "output_clip_path": "/data/output/split",
      "model_weights_path": "/config/models",
      "splitting_algorithm": "fixed-stride",
      "fixed_stride_split_duration": 30,
      "fixed_stride_min_clip_length_s": 2.0,
      "captioning_algorithm": "qwen3_vl_30b_fp8",
      "captioning_window_size": 60,
      "captioning_sampling_fps": 2.0,
      "captioning_max_output_tokens": 4096,
      "vllm_sampling_temperature": 0.1,
      "vllm_sampling_top_p": 0.001,
      "vllm_sampling_repetition_penalty": 1.05,
      "enhance_captions": true,
      "enhance_captions_prompt_variant": "default",
      "motion_filter": "score-only",
      "video_classifier": true,
      "video_classifier_use_custom_categories": true,
      "video_classifier_allow": [
        "forklift_collision_with_pedestrian",
        "forklift_collision_with_rack",
        "forklift_collision_with_vehicle",
        "forklift_tip_over",
        "worker_fall_from_height",
        "rack_collapse_with_falling_inventory",
        "worker_struck_by_moving_vehicle",
        "blocked_emergency_exit",
        "unauthorized_restricted_area_entry",
        "worker_without_required_ppe",
        "pedestrian_in_forklift_travel_zone",
        "forklift_traveling_with_raised_load",
        "spill_or_obstruction_in_aisle",
        "normal_warehouse_operations"
      ],
      "sam3": true,
      "sam3_prompts": [
        "a worker",
        "a forklift",
        "a pallet jack",
        "a rolling ladder",
        "a pallet",
        "a rack",
        "a hard hat",
        "a safety vest",
        "a traffic cone",
        "caution tape",
        "a box",
        "an emergency exit sign",
        "a reach truck",
        "a conveyor belt",
        "a loading dock",
        "a trailer",
        "a fire extinguisher",
        "a guard rail",
        "a safety barrier"
      ],
      "sam3_target_fps": 3.0,
      "sam3_max_clip_duration_s": 45.0,
      "sam3_det_nms_thresh": 0.1,
      "sam3_region": "box",
      "sam3_output_format": "native",
      "sam3_write_annotated_video": true,
      "sam3_annotated_video_trails": false,
      "sam3_annotated_video_label_style": "id",
      "sam3_annotated_video_mask_opacity": 0,
      "event_captioning": true,
      "event_caption_backend": "qwen",
      "event_caption_qwen_variant": "qwen3_vl_30b_fp8",
      "event_caption_prompt_file": "/data/event_caption_prompt.txt",
      "embedding_algorithm": "internvideo2",
      "generate_captions": true,
      "generate_embeddings": true,
      "upload_clips": true,
      "write_all_caption_json": true,
      "perf_profile": true
    }
  },
  "video_stats": {
    "camera_type": "fixed overhead CCTV",
    "environment": "indoor warehouse / distribution center"
  }
}
